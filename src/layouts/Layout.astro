    window.addEventListener('beforeinstallprompt',function(e){
      e.preventDefault();deferred=e;btn.hidden=false;
    });
    btn.addEventListener('click',function(){
      if(deferred){deferred.prompt();deferred.userChoice.then(function(){deferred=null;btn.hidden=true;});}
      else showDlg();
    });
    if(ios){btn.hidden=false;}
  })();
  // SPA: sinkron nav aktif (sekali saja, survive swap)
  if(!window.__strivOnce){window.__strivOnce=true;
    (function(){
      function syncNav(){
        var p=location.pathname.replace(/\/$/,'')||'/';
        document.querySelectorAll('.nav-links a,.nav-mobile a').forEach(function(a){
          var h=a.getAttribute('href');
          if(h===p||(h!=='/'&&p.indexOf(h)===0))a.setAttribute('aria-current','page');
          else a.removeAttribute('aria-current');
        });
      }
      syncNav();
      document.addEventListener('astro:after-swap',syncNav);
    })();
  }
})();
</script>
</body>
</html>
