        if(grid)g.hidden=!any;
      });
      empty.hidden=shown!==0;
      count.textContent='Menampilkan '+shown+' dari '+total+' video';
    }
    function reset(){q.value='';fcat='all';flang='all';bar.querySelectorAll('.vpill').forEach(function(p){p.classList.toggle('on',p.getAttribute('data-fcat')==='all'||p.getAttribute('data-flang')==='all');});apply();}
