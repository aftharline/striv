.do.ok{border:1px solid rgba(52,211,153,.25)}.do.ok b{color:#34d399}
.do.no{border:1px solid rgba(248,113,113,.25)}.do.no b{color:#f87171}
.do ul{list-style:none;display:grid;gap:.35rem}
/* faq */
#faq{background:#090a0c;border-top:1px solid var(--line)}
.faq-list{max-width:48rem;margin:2rem auto 0;display:grid;gap:.75rem}
details{background:#121419;border:1px solid var(--line);border-radius:14px;padding:1.1rem 1.25rem;cursor:pointer}
details[open]{border-color:rgba(183,240,0,.4)}
summary{font-weight:700;display:flex;justify-content:space-between;align-items:center;gap:1rem;list-style:none}
summary::-webkit-details-marker{display:none}
details p{margin-top:.75rem;color:var(--muted);font-size:.88rem}
/* final */
.final-box{max-width:56rem;margin:0 auto;background:#13151b;border:1px solid rgba(183,240,0,.3);border-radius:24px;padding:2.5rem 1.5rem;text-align:center;box-shadow:0 0 45px -8px rgba(183,240,0,.35)}
@media(min-width:768px){.final-box{padding:3.5rem}}
.final-box p{color:var(--muted);max-width:32rem;margin:1rem auto 1.75rem;font-size:.95rem}
.micro{margin-top:1.25rem;font-size:11px;font-family:monospace;color:var(--muted)}
/* spotlight */
.spot{display:grid;gap:1.25rem;background:#12141a;border:1px solid var(--line);border-radius:24px;padding:1.5rem;margin-top:2rem}
@media(min-width:768px){.spot{grid-template-columns:.9fr 1.1fr;align-items:center;padding:2rem}}
