    document.querySelectorAll('[data-book-open]').forEach(function(b){b.addEventListener('click',function(){dlg.showModal();});});
    dlg.querySelectorAll('[data-book-close]').forEach(function(b){b.addEventListener('click',function(){dlg.close();});});
    dlg.addEventListener('click',function(e){if(e.target===dlg)dlg.close();});
  })();
