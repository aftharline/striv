<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var hasIO = 'IntersectionObserver' in window;
  var els = document.querySelectorAll('.card,.step,.price,.mini,#faq details,.trans,.final-box,.chart,.frame,.fact,.sstep,.spot');
  els.forEach(function(el){ el.classList.add('rv'); });
  if(!reduce && hasIO){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e,i){ if(e.isIntersecting){ var t = e.target; t.style.transitionDelay = ((Array.prototype.indexOf.call(t.parentNode.children, t) % 3) * 90) + 'ms'; t.classList.add('on'); io.unobserve(t); setTimeout(function(){ t.style.transitionDelay = ''; }, 800); } });
    },{threshold:.12,rootMargin:'0px 0px -8% 0px'});
    els.forEach(function(el){ io.observe(el); });
    var fig = document.querySelector('.story-visual');
    var steps = document.querySelectorAll('.sstep');
    if(fig && steps.length){
      var so = new IntersectionObserver(function(es){
        es.forEach(function(e){ if(e.isIntersecting){ fig.setAttribute('data-active', e.target.getAttribute('data-s')); steps.forEach(function(x){ x.classList.toggle('live', x === e.target); }); } });
      },{rootMargin:'-45% 0px -45% 0px'});
      steps.forEach(function(s){ so.observe(s); });
    }
    var line = document.querySelector('.draw-line');
    if(line){
      var co = new IntersectionObserver(function(es){
        es.forEach(function(e){ if(e.isIntersecting){ line.classList.add('drawn'); co.disconnect(); } });
      },{threshold:.4});
      co.observe(line);
    }
  } else {
    els.forEach(function(el){ el.classList.add('on'); });
    var l = document.querySelector('.draw-line'); if(l){ l.classList.add('drawn'); }
  }
  // facade video: klik thumbnail -> muat iframe youtube-nocookie (sekali saja, survive swap)
  if(!window.__strivFacade){window.__strivFacade=true;
  document.addEventListener('click',function(e){
    var a=e.target&&e.target.closest?e.target.closest('.vid a'):null;
    if(!a)return;
    var box=a.closest('.vid');
    if(!box||box.querySelector('iframe'))return;
    e.preventDefault();
    var id=box.getAttribute('data-yt');
    box.innerHTML='<iframe src="https://www.youtube-nocookie.com/embed/'+id+'?autoplay=1&rel=0" title="Video tutorial YouTube" allow="accelerometer;autoplay;encrypted-media;picture-in-picture" allowfullscreen></iframe>';
  });
  }
  // filter video: search + kategori + bahasa
  (function(){
    var bar=document.getElementById('vtoolbar');
    if(!bar)return;
    var q=document.getElementById('vsearch'),count=document.getElementById('vcount'),empty=document.getElementById('vempty');
    var fcat='all',flang='all';
    function cards(){return Array.prototype.slice.call(document.querySelectorAll('#movement .mini[data-cat]'));}
    function apply(){
      var s=(q.value||'').toLowerCase().trim(),shown=0,total=cards().length;
      cards().forEach(function(c){
        var ok=(fcat==='all'||c.getAttribute('data-cat')===fcat)&&(flang==='all'||c.getAttribute('data-lang')===flang)&&(!s||c.textContent.toLowerCase().indexOf(s)!==-1);
        c.hidden=!ok;
        if(ok)shown++;
      });
      Array.prototype.forEach.call(document.querySelectorAll('#movement .mini-head'),function(h){
        var g=h.nextElementSibling,grid=g&&g.classList&&g.classList.contains('mini-grid');
        var any=grid?g.querySelector('.mini:not([hidden])'):null;
