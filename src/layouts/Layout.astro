.spot .quote{margin-top:.75rem}
.spot-meta{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-top:1rem;font-size:11px;font-family:monospace;color:var(--muted)}
.spot-meta b{color:var(--lime)}
.store-mark{width:min(280px,70vw);height:auto;margin:0 auto 1.5rem;display:block}
/* video facade (klik-untuk-muat) */
.vid{position:relative;aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden;border:1px solid var(--line)}
.vid a{display:block;position:absolute;inset:0}
.vid img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.vid .play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:58px;height:58px;border-radius:50%;background:rgba(183,240,0,.92);box-shadow:0 0 24px rgba(183,240,0,.5);transition:transform .2s ease}
.vid a:hover .play{transform:translate(-50%,-50%) scale(1.08)}
.vid .play::after{content:"";position:absolute;top:50%;left:54%;transform:translate(-50%,-50%);border-left:18px solid #101010;border-top:11px solid transparent;border-bottom:11px solid transparent}
.vid iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.vid-credit{font-family:monospace;font-size:10px;letter-spacing:.04em;color:var(--muted)}
.vid-credit b{color:var(--lime)}
/* video toolbar (search + filter) */
.vtoolbar{position:sticky;top:4.25rem;z-index:30;background:rgba(16,16,16,.94);backdrop-filter:blur(14px);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.vtoolbar .vbar-in{max-width:var(--max);margin:0 auto;padding:.9rem 1rem;display:grid;gap:.6rem}
@media(min-width:768px){.vtoolbar .vbar-in{padding:.9rem 1.5rem}}
@media(max-width:1023px){.vtoolbar{top:7.2rem}}
#vsearch{width:100%;background:#0b0c0e;border:1px solid var(--line2);border-radius:8px;color:var(--ink);font-size:.9rem;padding:.65rem .9rem;font-family:inherit}
#vsearch:focus{outline:none;border-color:rgba(183,240,0,.5)}
.vpills{display:flex;gap:.4rem;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.vpills::-webkit-scrollbar{display:none}
.vpill{flex:none;background:transparent;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:11px;font-weight:700;letter-spacing:.06em;padding:.4rem .85rem;cursor:pointer;font-family:monospace;text-transform:uppercase}
.vpill:hover{color:#fff;border-color:var(--line2)}
.vpill.on{color:var(--lime);border-color:rgba(183,240,0,.5);background:rgba(183,240,0,.08)}
.vcount{font-family:monospace;font-size:11px;color:var(--muted)}
.vempty{text-align:center;border:1px dashed var(--line2);border-radius:var(--r-lg);padding:2rem 1rem;margin-top:1rem;color:var(--muted)}
.vempty .btn{margin-top:1rem}
.mini[hidden]{display:none}
.subnav{position:sticky;top:4.25rem;z-index:25;background:rgba(16,16,16,.94);backdrop-filter:blur(14px);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
@media(max-width:1023px){.subnav{position:static}}
.subnav-in{max-width:var(--max);margin:0 auto;padding:.55rem 1rem;display:flex;gap:.4rem;flex-wrap:wrap;justify-content:center}
.subnav-in a{flex:none;text-decoration:none;font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:.4rem .85rem;font-family:monospace;text-transform:uppercase;white-space:nowrap}
.subnav-in a:hover{color:#fff;border-color:var(--line2)}
main:has(> .subnav) section[id]{scroll-margin-top:8rem}
main:has(> .subnav) .vtoolbar{top:7.3rem}
.secnav{display:flex;justify-content:space-between;gap:.6rem;margin-top:2rem;flex-wrap:wrap}
.secnav .btn{white-space:nowrap}
@media(max-width:560px){.secnav .btn{flex:1 1 100%}}
/* popup master book */
.bookdlg{position:fixed;inset:0;margin:auto;border:1px solid var(--line2);border-radius:var(--r-lg);background:#141414;color:var(--ink);padding:0;width:min(26rem,calc(100vw - 2rem));height:fit-content;max-width:min(26rem,calc(100vw - 2rem));max-height:calc(100vh - 4rem);overflow:auto}
.bookdlg::backdrop{background:rgba(0,0,0,.7);backdrop-filter:blur(4px)}
.bookdlg .dlg-in{padding:1.75rem;display:grid;gap:1rem;text-align:center}
.bookdlg .dlg-in .btn{width:100%}
.bookdlg h3{font-size:1.25rem}
.bookdlg p{color:var(--muted);font-size:.85rem}
.bookdlg .dlg-x{position:absolute;top:.6rem;right:.6rem;background:var(--card);border:1px solid var(--line);border-radius:8px;color:var(--muted);width:2rem;height:2rem;cursor:pointer;font-size:1rem;line-height:1}
.bookdlg .dlg-x:hover{color:#fff;border-color:var(--line2)}
/* footer */
footer{background:#08090b;border-top:1px solid var(--line);padding:3rem 0 2rem;color:var(--muted);font-size:.8rem}
.fgrid{display:grid;gap:2rem;padding-bottom:2rem;border-bottom:1px solid var(--line)}
@media(min-width:768px){.fgrid{grid-template-columns:2fr 1fr 1fr}}
.fgrid h5{color:#fff;font-size:11px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.75rem;font-family:monospace}
.fgrid ul{list-style:none;display:grid;gap:.5rem}
.fgrid a{text-decoration:none}.fgrid a:hover{color:var(--lime)}
.fbot{display:flex;flex-direction:column;gap:.5rem;align-items:center;justify-content:space-between;padding-top:1.5rem;font-size:11px;font-family:monospace}
@media(min-width:640px){.fbot{flex-direction:row}}
</style>
</head>
