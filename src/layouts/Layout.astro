    bar.querySelectorAll('.vpill[data-flang]').forEach(function(p){p.addEventListener('click',function(){flang=p.getAttribute('data-flang');bar.querySelectorAll('.vpill[data-flang]').forEach(function(x){x.classList.toggle('on',x===p);});apply();});});
    document.getElementById('vreset').addEventListener('click',reset);
    apply();
  })();
  // popup master book
  (function(){
    var dlg=document.getElementById('bookdlg');
