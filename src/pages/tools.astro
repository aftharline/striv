---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout active="tools" title="STRIV Tools: Logger, Kalkulator, Timer & Program Builder." description="Tools fitness gratis: workout logger, kalkulator 1RM & TDEE, rest timer HIIT, dan program builder. Data tersimpan di HP-mu.">
<style>
  .tabs{display:flex;gap:.4rem;overflow-x:auto;scrollbar-width:none;margin-top:1.75rem;justify-content:flex-start}
  @media(min-width:640px){.tabs{justify-content:center}}
  .tabs::-webkit-scrollbar{display:none}
  .tab{flex:none;background:transparent;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:11px;font-weight:700;letter-spacing:.06em;padding:.55rem 1.1rem;cursor:pointer;font-family:monospace;text-transform:uppercase}
  .tab.on{color:var(--lime);border-color:rgba(183,240,0,.5);background:rgba(183,240,0,.08)}
  .toolpane{display:none;margin-top:1.5rem}
  .toolpane.on{display:block}
  .field{display:grid;gap:.35rem;margin-bottom:.8rem}
  .field label{font-size:10px;font-family:monospace;letter-spacing:.1em;color:var(--muted);text-transform:uppercase}
  .field input,.field select{background:#0b0c0e;border:1px solid var(--line2);border-radius:8px;color:var(--ink);font-size:.9rem;padding:.65rem .9rem;font-family:inherit;width:100%}
  .field input:focus,.field select:focus{outline:none;border-color:rgba(183,240,0,.5)}
  .frow{display:grid;gap:.8rem;grid-template-columns:1fr 1fr}
  @media(max-width:480px){.frow{grid-template-columns:1fr}}
  .timer-big{font-family:"Plus Jakarta Sans";font-weight:800;font-size:clamp(3.5rem,14vw,5.5rem);text-align:center;line-height:1;color:#fff;font-variant-numeric:tabular-nums}
  .heat{display:grid;grid-template-columns:repeat(12,1fr);gap:3px;margin-top:.5rem}
  .heat i{aspect-ratio:1/1;border-radius:3px;background:#262626}
  .bar{height:10px;background:#262626;border-radius:99px;overflow:hidden;margin-top:.5rem}
  .bar b{display:block;height:100%;background:var(--lime);border-radius:99px}
  .timer-state{text-align:center;font-family:monospace;font-size:11px;letter-spacing:.12em;color:var(--lime);margin:.5rem 0 1rem}
  .tbtns{display:flex;gap:.6rem;justify-content:center;flex-wrap:wrap}
  .result{background:#0b0c0e;border:1px solid var(--line);border-radius:8px;padding:.75rem 1rem;font-size:.85rem;color:#d4d4d4;margin-top:.8rem}
  .result b{color:var(--lime)}
  .logrow{display:flex;justify-content:space-between;gap:.5rem;padding:.5rem 0;border-bottom:1px solid var(--line);font-size:.82rem}
  .logrow small{color:var(--muted);font-family:monospace}
  table.plan{width:100%;border-collapse:collapse;font-size:.82rem;margin-top:.8rem}
  table.plan th,table.plan td{padding:.55rem .7rem;border-bottom:1px solid var(--line);text-align:left}
  table.plan th{font-family:monospace;font-size:10px;letter-spacing:.08em;color:var(--lime)}
</style>

<section class="hero"><div class="hero-slides slides-1" aria-hidden="true"><img src="/hero-tools-1.webp" alt="" fetchpriority="high" /></div><div class="wrap">
  <img class="hero-mark" src="/symbol_logo.svg" alt="STRIV" width="64" height="64" fetchpriority="high" />
  <span class="eyebrow">[STRIV TOOLS] | GRATIS • OFFLINE • TANPA AKUN</span>
  <h1>Your Gym.<br /><em>In Your Pocket.</em></h1>
  <p>Catat latihan, hitung kebutuhan, atur timer, susun program, semua di HP-mu, bisa offline setelah install.</p>
  <div class="tabs" role="tablist" aria-label="Tools">
    <button type="button" class="tab on" data-tab="logger" role="tab">Logger</button>
    <button type="button" class="tab" data-tab="tracker" role="tab">Tracker</button>
    <button type="button" class="tab" data-tab="kalk" role="tab">Kalkulator</button>
    <button type="button" class="tab" data-tab="lari" role="tab">Lari</button>
    <button type="button" class="tab" data-tab="timer" role="tab">Timer</button>
    <button type="button" class="tab" data-tab="builder" role="tab">Program</button>
  </div>
</div></section>

<nav class="subnav" aria-label="Navigasi Tools"><div class="subnav-in"><a href="#top">Atas</a><a href="#panes" data-goto="logger">Logger</a><a href="#panes" data-goto="tracker">Tracker</a><a href="#panes" data-goto="kalk">Kalkulator</a><a href="#panes" data-goto="lari">Lari</a><a href="#panes" data-goto="timer">Timer</a><a href="#panes" data-goto="builder">Program</a></div></nav>

<div class="wrap" id="panes" style="padding-bottom:4rem;scroll-margin-top:10rem">
<!-- LOGGER -->
<div class="toolpane on" id="pane-logger">
  <div class="grid3" style="margin-top:0">
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[CATAT SET]</span>
      <h3><Icon name="dumbbell" size={20} /> Set Baru</h3>
      <div class="field"><label>Gerakan</label><input id="lg-ex" list="lg-list" placeholder="mis. Squat" autocomplete="off" /><datalist id="lg-list"></datalist></div>
      <div class="frow">
        <div class="field"><label>Beban (kg)</label><input id="lg-w" type="number" min="0" step="0.5" value="20" /></div>
        <div class="field"><label>Reps</label><input id="lg-r" type="number" min="1" step="1" value="8" /></div>
      </div>
      <div class="field"><label>RPE (1–10)</label><input id="lg-rpe" type="number" min="1" max="10" step="0.5" value="8" /></div>
      <button type="button" class="btn btn-lime btn-sm" id="lg-add" style="width:100%">Tambah Set</button>
      <div class="foot"><span id="lg-today">Hari ini: 0 set</span><span>tersimpan lokal</span></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[PROGRES]</span>
      <h3><Icon name="chart-line" size={20} /> PR &amp; Grafik</h3>
      <div class="field"><label>Lihat gerakan</label><select id="lg-chart"></select></div>
      <div id="lg-pr"></div>
      <svg id="lg-svg" viewBox="0 0 300 120" style="width:100%;height:auto;display:block;margin-top:.5rem" role="img" aria-label="Grafik volume latihan"></svg>
      <div class="tbtns" style="margin-top:.6rem;justify-content:flex-start">
        <button type="button" class="btn btn-lime btn-sm" id="lg-share">Share PR (PNG)</button>
      </div>
      <canvas id="pr-canvas" width="1080" height="1080" hidden></canvas>
      <div class="foot"><span>volume = beban × reps</span><span>12 sesi terakhir</span></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[RIWAYAT]</span>
      <h3><Icon name="calendar-check" size={20} /> 7 Hari Terakhir</h3>
      <div id="lg-hist"></div>
      <div class="tbtns" style="margin-top:1rem;justify-content:flex-start">
        <button type="button" class="btn btn-ghost btn-sm" id="lg-export">Export</button>
        <button type="button" class="btn btn-ghost btn-sm" id="lg-import-btn">Import</button>
        <input type="file" id="lg-import" accept="application/json" hidden />
      </div>
      <div class="foot"><span>JSON • siap-cloud nanti</span><span id="lg-count"></span></div>
    </div>
  </div>
</div>

<!-- KALKULATOR -->
<div class="toolpane" id="pane-kalk">
  <div class="grid3" style="margin-top:0">
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[1RM]</span>
      <h3><Icon name="zap" size={20} /> Estimasi 1RM</h3>
      <div class="frow">
        <div class="field"><label>Beban (kg)</label><input id="c-w" type="number" min="1" value="60" /></div>
        <div class="field"><label>Reps maks</label><input id="c-r" type="number" min="1" max="12" value="5" /></div>
      </div>
      <button type="button" class="btn btn-lime btn-sm" id="c-go" style="width:100%">Hitung</button>
      <div class="result" id="c-out">1RM ≈ <b>-</b></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[TDEE]</span>
      <h3><Icon name="activity" size={20} /> Kalori &amp; Protein</h3>
      <div class="frow">
        <div class="field"><label>BB (kg)</label><input id="t-bb" type="number" min="30" value="70" /></div>
        <div class="field"><label>TB (cm)</label><input id="t-tb" type="number" min="130" value="170" /></div>
      </div>
      <div class="frow">
        <div class="field"><label>Umur</label><input id="t-u" type="number" min="14" value="25" /></div>
        <div class="field"><label>Aktivitas</label><select id="t-a"><option value="1.375">Ringan (1–3x/minggu)</option><option value="1.55" selected>Sedang (3–5x)</option><option value="1.725">Berat (6–7x)</option></select></div>
      </div>
      <button type="button" class="btn btn-lime btn-sm" id="t-go" style="width:100%">Hitung</button>
      <div class="result" id="t-out">TDEE ≈ <b>-</b></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[PLATE]</span>
      <h3><Icon name="dumbbell" size={20} /> Plate Barbel 20kg</h3>
      <div class="field"><label>Target total (kg)</label><input id="p-t" type="number" min="25" step="2.5" value="60" /></div>
      <button type="button" class="btn btn-lime btn-sm" id="p-go" style="width:100%">Hitung</button>
      <div class="result" id="p-out">Per sisi: <b>-</b></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[WILKS]</span>
      <h3><Icon name="zap" size={20} /> Skor Wilks</h3>
      <div class="frow">
        <div class="field"><label>Total SBD (kg)</label><input id="w-t" type="number" min="0" value="300" /></div>
        <div class="field"><label>BB (kg)</label><input id="w-bb" type="number" min="30" value="70" /></div>
      </div>
      <div class="field"><label>Kategori</label><select id="w-s"><option value="m">Putra</option><option value="f">Putri</option></select></div>
      <button type="button" class="btn btn-lime btn-sm" id="w-go" style="width:100%">Hitung</button>
      <div class="result" id="w-out">Wilks ≈ <b>-</b></div>
    </div>
  </div>
</div>

<!-- TIMER -->
<div class="toolpane" id="pane-timer">
  <div class="grid3" style="margin-top:0">
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[REST]</span>
      <h3><Icon name="calendar-check" size={20} /> Rest Antar Set</h3>
      <div class="timer-big" id="tm-display">01:00</div>
      <div class="timer-state" id="tm-state">SIAP • PILIH DURASI</div>
      <div class="tbtns">
        <button type="button" class="btn btn-ghost btn-sm" data-rest="60">1 mnt</button>
        <button type="button" class="btn btn-ghost btn-sm" data-rest="120">2 mnt</button>
        <button type="button" class="btn btn-ghost btn-sm" data-rest="180">3 mnt</button>
        <button type="button" class="btn btn-ghost btn-sm" data-rest="300">5 mnt</button>
      </div>
      <div class="tbtns" style="margin-top:.6rem">
        <button type="button" class="btn btn-lime btn-sm" id="tm-start">Mulai</button>
        <button type="button" class="btn btn-ghost btn-sm" id="tm-reset">Reset</button>
      </div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[HIIT]</span>
      <h3><Icon name="trending-up" size={20} /> Interval Timer</h3>
      <div class="frow">
        <div class="field"><label>Kerja (detik)</label><input id="hi-w" type="number" min="5" value="30" /></div>
        <div class="field"><label>Rest (detik)</label><input id="hi-r" type="number" min="5" value="15" /></div>
      </div>
      <div class="field"><label>Ronde</label><input id="hi-n" type="number" min="1" max="30" value="8" /></div>
      <div class="tbtns">
        <button type="button" class="btn btn-lime btn-sm" id="hi-start">Mulai HIIT</button>
        <button type="button" class="btn btn-ghost btn-sm" id="hi-stop">Stop</button>
      </div>
      <div class="foot"><span>bunyi + getar tiap ganti fase</span><span id="hi-state"></span></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[CATATAN]</span>
      <h3><Icon name="clipboard-check" size={20} /> Biar Akurat</h3>
      <p>Browser membatasi timer saat layar mati, untuk sesi penting kunci layar mati (tetap nyala) atau pakai jam tangan. Bunyi memakai WebAudio, tanpa file.</p>
      <div class="foot"><span>rest ≥2 mnt untuk strength</span><span><a class="src" href="/lab#metode">RPE/RIR →</a></span></div>
    </div>
  </div>
</div>

<!-- BUILDER -->
<div class="toolpane" id="pane-builder">
  <div class="center"><span class="eyebrow">[PROGRAM BUILDER]</span>
    <h2 class="sec-title">Susun Split-mu.</h2>
    <p class="sec-sub">Template berbasis STRIV Lab. Hasil bisa dikirim ke Logger sebagai panduan sesi hari ini.</p>
  </div>
  <div class="grid3">
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[INPUT]</span>
      <h3><Icon name="users" size={20} /> Profilmu</h3>
      <div class="field"><label>Goal utama</label><select id="b-goal"><option value="otot">Otot besar (hipertrofi)</option><option value="kuat">Kuat (powerlifting)</option><option value="fatloss">Fat loss + bugar</option><option value="hybrid">Hybrid (kuat + lari)</option></select></div>
      <div class="field"><label>Hari per minggu</label><select id="b-days"><option value="3">3 hari</option><option value="4">4 hari</option><option value="5">5 hari</option></select></div>
      <button type="button" class="btn btn-lime btn-sm" id="b-go" style="width:100%">Generate Program</button>
    </div>
    <div class="card" style="grid-column:span 1"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[HASIL]</span>
      <h3><Icon name="chart-line" size={20} /> Split Mingguan</h3>
      <div id="b-out"><p>Belum ada program. Pilih goal &amp; generate.</p></div>
      <div class="tbtns" style="margin-top:1rem;justify-content:flex-start">
        <button type="button" class="btn btn-lime btn-sm" id="b-send" disabled>Kirim ke Logger</button>
        <button type="button" class="btn btn-ghost btn-sm" id="b-copy" disabled>Salin Teks</button>
      </div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[ATURAN MAIN]</span>
      <h3><Icon name="shield-check" size={20} /> Progres Mingguan</h3>
      <p>Naikkan 2–10% saat batas atas reps tercapai (double progression). Tiap 4–8 minggu ambil deload −40–60%. Stagnan 2 minggu? Cek tidur &amp; protein dulu.</p>
      <div class="foot"><span>detail di Lab</span><span><a class="src" href="/lab#metode">12 metode →</a></span></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[WARM-UP]</span>
      <h3><Icon name="activity" size={20} /> Pemanasan Acak</h3>
      <div class="field"><label>Fokus sesi</label><select id="wu-f"><option value="squat">Squat / Kaki</option><option value="bench">Bench / Upper</option><option value="deadlift">Deadlift / Hinge</option><option value="general">General / HIIT</option></select></div>
      <button type="button" class="btn btn-lime btn-sm" id="wu-go" style="width:100%">Generate 5–10 mnt</button>
      <div id="wu-out" style="margin-top:.6rem"></div>
    </div>
  </div>
</div>

<!-- TRACKER -->
<div class="toolpane" id="pane-tracker">
  <div class="grid3" style="margin-top:0">
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[BADAN]</span>
      <h3><Icon name="users" size={20} /> Ukur Badan</h3>
      <div class="frow">
        <div class="field"><label>BB (kg)</label><input id="tr-bb" type="number" min="20" step="0.1" placeholder="70" /></div>
        <div class="field"><label>Pinggang (cm)</label><input id="tr-pg" type="number" min="0" step="0.5" placeholder="opsional" /></div>
      </div>
      <div class="frow">
        <div class="field"><label>Dada (cm)</label><input id="tr-dd" type="number" min="0" step="0.5" placeholder="opsional" /></div>
        <div class="field"><label>Lengan (cm)</label><input id="tr-lg" type="number" min="0" step="0.5" placeholder="opsional" /></div>
      </div>
      <button type="button" class="btn btn-lime btn-sm" id="tr-add" style="width:100%">Catat Hari Ini</button>
      <svg id="tr-svg" viewBox="0 0 300 80" style="width:100%;height:auto;display:block;margin-top:.5rem" role="img" aria-label="Grafik berat badan"></svg>
      <div class="foot"><span id="tr-last">belum ada data</span><span>BB + lingkar</span></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[STREAK]</span>
      <h3><Icon name="calendar-check" size={20} /> Konsistensi 12 Minggu</h3>
      <div class="heat" id="tr-heat"></div>
      <div class="foot"><span id="tr-streak">0 sesi / 84 hari</span><span>dari Logger</span></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[PROTEIN]</span>
      <h3><Icon name="clipboard-check" size={20} /> Protein Harian</h3>
      <div class="result" id="pr-target">Target: <b>-</b></div>
      <div class="frow" style="margin-top:.6rem">
        <div class="field"><label>BB (kg)</label><input id="pr-bb" type="number" min="20" value="70" /></div>
        <div class="field"><label>Protein (g)</label><input id="pr-g" type="number" min="0" value="30" /></div>
      </div>
      <button type="button" class="btn btn-lime btn-sm" id="pr-add" style="width:100%">Catat Makan</button>
      <div class="bar"><b id="pr-bar" style="width:0%"></b></div>
      <div class="foot"><span id="pr-today">0g hari ini</span><span>1,6 g/kg</span></div>
    </div>
  </div>
  <div class="grid3">
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[READINESS]</span>
      <h3><Icon name="sparkles" size={20} /> Siap Latihan?</h3>
      <div class="frow">
        <div class="field"><label>Tidur (1–5)</label><select id="rd-t"><option>5</option><option>4</option><option selected>3</option><option>2</option><option>1</option></select></div>
        <div class="field"><label>Nyeri/capek (1–5)</label><select id="rd-n"><option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option></select></div>
      </div>
      <div class="field"><label>Energi/mood (1–5)</label><select id="rd-e"><option>5</option><option>4</option><option selected>3</option><option>2</option><option>1</option></select></div>
      <button type="button" class="btn btn-lime btn-sm" id="rd-go" style="width:100%">Cek Readiness</button>
      <div class="result" id="rd-out">Skor: <b>-</b></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[INFO]</span>
      <h3><Icon name="shield-check" size={20} /> Baca Datamu</h3>
      <p>Streak dibaca otomatis dari Logger: makin konsisten, makin hijau. BB &amp; lingkar cukup diukur 1–2× seminggu, bukan tiap hari. Protein ikut target 1,6 g/kg dari Lab.</p>
      <div class="foot"><span>semua tersimpan lokal</span><span><a class="src" href="/lab#blog">Lab →</a></span></div>
    </div>
  </div>
</div>

<!-- LARI -->
<div class="toolpane" id="pane-lari">
  <div class="grid3" style="margin-top:0">
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[HR ZONE]</span>
      <h3><Icon name="activity" size={20} /> Zona Detak Jantung</h3>
      <div class="frow">
        <div class="field"><label>HR maks</label><input id="hr-max" type="number" min="120" max="220" value="190" /></div>
        <div class="field"><label>HR istirahat</label><input id="hr-rest" type="number" min="30" max="100" value="60" /></div>
      </div>
      <button type="button" class="btn btn-lime btn-sm" id="hr-go" style="width:100%">Hitung Zona</button>
      <div id="hr-out" style="margin-top:.6rem"></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[PACE]</span>
      <h3><Icon name="trending-up" size={20} /> Pace &amp; Estimasi</h3>
      <div class="frow">
        <div class="field"><label>Jarak (km)</label><input id="pc-d" type="number" min="0.1" step="0.1" value="5" /></div>
        <div class="field"><label>Waktu (mm:ss)</label><input id="pc-t" value="30:00" /></div>
      </div>
      <button type="button" class="btn btn-lime btn-sm" id="pc-go" style="width:100%">Hitung Pace</button>
      <div class="result" id="pc-out">Pace: <b>-</b></div>
      <div class="frow" style="margin-top:.6rem">
        <div class="field"><label>Target pace (/km)</label><input id="pc-p" value="6:00" /></div>
        <div class="field"><label>Jarak target</label><input id="pc-d2" type="number" min="0.1" step="0.1" value="10" /></div>
      </div>
      <button type="button" class="btn btn-ghost btn-sm" id="pc-go2" style="width:100%">Estimasi Finish</button>
      <div class="result" id="pc-out2">Finish: <b>-</b></div>
    </div>
    <div class="card"><span class="tag" style="color:var(--lime);border-color:rgba(183,240,0,.35)">[HYBRID]</span>
      <h3><Icon name="zap" size={20} /> Aturan Hybrid</h3>
      <p>80% lari di zona 2 (bisa ngobrol), 20% interval. Pisahkan hari beban berat &amp; lari berat. Sepeda/zona 2 bila otot prioritas.</p>
