    'otot-4':[['Upper A',['Bench Press','Barbell Row','Overhead Press','Curl']],['Lower A',['Squat','RDL','Leg Press','Calf Raise']],['Upper B',['Overhead Press','Pull-up','Incline DB','Triceps']],['Lower B',['Deadlift','Bulgarian Split Squat','Hip Thrust','Plank']]],
    'kuat-4':[['Squat',['Squat 5×3','Pause Squat 3×5','Core']],['Bench',['Bench 5×3','Close-grip 3×8','Row 3×8']],['Deadlift',['Deadlift 3×3','RDL 3×8','Pull-up']],['Press + Volume',['Overhead Press 4×5','Squat 3×5','Bench 3×8']]],
    'fatloss-4':[['Circuit A',['Goblet Squat','Push-up','Row','Plank']],['HIIT',['HIIT 10×30:15','Farmer Carry']],['Circuit B',['Deadlift ringan','Lunges','Overhead Press','Hollow Hold']],['Jalan + Core',['Jalan 45 mnt','Side Plank','Glute Bridge']]],
