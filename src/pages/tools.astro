    var d=parseFloat($('pc-d').value)||0,t=parseT($('pc-t').value);
    if(d<=0||t<=0)return;
    $('pc-out').innerHTML='Pace: <b>'+fmtP(t/d)+'/km</b> ('+(d/(t/3600)).toFixed(1)+' km/jam)';
  });
  $('pc-go2').addEventListener('click',function(){
    var p=parseT($('pc-p').value),d=parseFloat($('pc-d2').value)||0;
    if(p<=0||d<=0)return;
    var t=p*d;$('pc-out2').innerHTML='Finish: <b>'+fmtP(t)+'</b> untuk '+d+'km @ '+fmtP(p)+'/km';
  });
  // ---- WARM-UP ----
  var WU={
    squat:[['Bodyweight Squat ×15',45],['Walking Lunge ×10/sisi',60],['Glute Bridge ×15',45],['Ankle Rock ×10/sisi',45],['Leg Swing ×10/sisi',45],['Goblet Squat ringan ×10',60]],
    bench:[['Push-up Incline ×10',45],['Band Pull-apart ×15',45],['Scap Push-up ×10',45],['Arm Circle ×10',30],['Wall Slide ×10',45],['Plank 30 dtk',30]],
    deadlift:[['Good Morning PVC ×12',45],['Glute Bridge ×15',45],['Bird Dog ×8/sisi',60],['Cat-Cow ×8',45],['RDL ringan ×10',60],['Farmer Carry 30 dtk',30]],
    general:[['Jumping Jack 30 dtk',30],['Skipping 1 mnt',60],['Dead Hang 20 dtk',20],['World Stretch ×5/sisi',60],['Bear Crawl 20 m',45],['Inchworm ×6',45]]
  };
  $('wu-go').addEventListener('click',function(){
    var bank=(WU[$('wu-f').value]||WU.general).slice().sort(function(){return Math.random()-0.5;}).slice(0,5);
    bank.push(WU.general.slice().sort(function(){return Math.random()-0.5;})[0]);
    var tot=bank.reduce(function(a,b){return a+b[1];},0);
    $('wu-out').innerHTML=bank.map(function(b,i){return '<div class="logrow"><span>'+(i+1)+'. '+b[0]+'</span><small>'+b[1]+' dtk</small></div>';}).join('')+
      '<div class="result">Total ±<b>'+Math.round(tot/60)+' mnt</b>: gas setelah ini.</div>';
  });
  refreshLogger();
})();
</script>
</Layout>
