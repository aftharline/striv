---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout active="store" title="STRIV Store — Coming Soon." description="Merchandise dan gear resmi STRIV Surabaya. Segera hadir.">

<section class="hero"><div class="wrap">
  <div class="final-box">
    <img class="store-mark" src="/text_logo.svg" alt="STRIV" width="280" height="70" fetchpriority="high" />
    <span class="eyebrow">[STRIV STORE // MERCHANDISE &amp; GEAR]</span>
    <h2 class="sec-title" style="font-size:clamp(2.5rem,8vw,4rem)">Coming Soon.</h2>
    <p>Kaos, shaker, lifting belt, dan gear resmi STRIV sedang disiapkan. Anggota komunitas dapat akses pre-order pertama — dan harga founding.</p>
    <div class="cta-row" style="margin-bottom:0">
      <a class="btn btn-lime" href="/community"><Icon name="users" size={16} /> Join Komunitas Dulu</a>
      <a class="btn btn-ghost" href="/about">Kenalan dengan STRIV</a>
    </div>
    <div class="micro">[PRE-ORDER PRIORITAS UNTUK MEMBER]</div>
  </div>
</div></section>

</Layout>
